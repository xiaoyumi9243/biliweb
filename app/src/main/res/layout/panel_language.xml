<?xml version="1.0" encoding="utf-8"?>
<!-- 语言面板：跟随系统 / 中文 / English -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_language_title"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/language_hint"
            android:textColor="#888888"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/language_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/language_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/language_follow_system"
                android:textColor="#212121"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/language_zh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/language_chinese"
                android:textColor="#212121"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/language_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/language_english"
                android:textColor="#212121"
                android:textSize="15sp" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
