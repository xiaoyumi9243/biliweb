<?xml version="1.0" encoding="utf-8"?>
<!-- 屏幕方向设置面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_orientation_title"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/orientation_hint"
        android:textColor="#888888"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/orientation_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/orientation_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/orientation_default"
            android:textColor="#212121"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/orientation_landscape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/orientation_landscape"
            android:textColor="#212121"
            android:textSize="15sp" />

    </RadioGroup>

</LinearLayout>
