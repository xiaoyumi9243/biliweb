<?xml version="1.0" encoding="utf-8"?>
<!-- 设置项列表（长条按钮）。竖屏/横屏两套布局共用，改一处即可 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/row_zoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_zoom_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/zoom_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="100%（默认）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_orientation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_orientation_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/orientation_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="默认" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/row_mouse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_mouse_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mouse_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="关闭" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_float_ball"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_float_ball_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/float_ball_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="100% · 100%" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_appearance_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/appearance_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="全屏" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_debug_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/debug_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="关闭" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_language_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/language_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="跟随系统" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_about_title"
            android:textColor="#212121"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/about_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#999999"
            android:textSize="14sp"
            tools:text="1.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chevron"
            android:textColor="#BBBBBB"
            android:textSize="20sp" />

    </LinearLayout>
</LinearLayout>
