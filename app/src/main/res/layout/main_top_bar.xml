<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面顶栏（「顶部导航栏」外观方案才显示）：
     后退 / 前进 / 刷新 / 地址栏 / 标签页 / 设置。设置按钮长按可开关虚拟鼠标。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_top_bar"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@android:color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/nav_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/toolbar_back"
        android:padding="8dp"
        android:src="@drawable/ic_nav_back" />

    <ImageButton
        android:id="@+id/nav_forward"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/toolbar_forward"
        android:padding="8dp"
        android:src="@drawable/ic_nav_forward" />

    <ImageButton
        android:id="@+id/nav_refresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/toolbar_refresh"
        android:padding="8dp"
        android:src="@drawable/ic_nav_refresh" />

    <EditText
        android:id="@+id/nav_address"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_address_bar"
        android:hint="@string/toolbar_address_hint"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:singleLine="true"
        android:textColor="#212121"
        android:textColorHint="#999999"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageButton
            android:id="@+id/nav_tabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toolbar_tabs"
            android:padding="8dp"
            android:src="@drawable/ic_nav_tabs" />

        <TextView
            android:id="@+id/nav_tabs_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_tab_badge"
            android:gravity="center"
            android:minWidth="16dp"
            android:minHeight="16dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <ImageButton
        android:id="@+id/nav_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/toolbar_settings"
        android:padding="8dp"
        android:src="@drawable/ic_settings" />

</LinearLayout>
